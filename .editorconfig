# SPDX-License-Identifier: Apache-2.0
# Editor defaults. Formatting is enforced by Spotless (Java) and Prettier/ESLint (UI).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
# google-java-format
indent_size = 2
max_line_length = 100

[*.{kt,kts}]
indent_size = 2
max_line_length = 100

[*.{bat,cmd}]
end_of_line = crlf

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{proto,sql,sh,bash}]
indent_size = 2

[gradle/verification-metadata.xml]
indent_size = 3
