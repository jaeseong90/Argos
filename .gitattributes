# SPDX-License-Identifier: Apache-2.0
# Line endings: LF in the repository and in working trees, except Windows batch files.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

# Scripts must keep LF to run on Linux runners and in containers.
*.sh text eol=lf
gradlew text eol=lf

# Binary files: no line-ending conversion, no textual diff.
*.jar binary
*.class binary
*.classdata binary
*.war binary
*.ear binary
*.zip binary
*.gz binary
*.tgz binary
*.tar binary
*.xz binary
*.7z binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.bmp binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.mp4 binary
*.webm binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.p12 binary
*.jks binary
*.keystore binary
*.gpg binary

# Lock and generated files: no merge conflict markers inside, regenerate instead.
gradle.lockfile linguist-generated=true
pnpm-lock.yaml linguist-generated=true -diff
gradle/verification-metadata.xml linguist-generated=true
