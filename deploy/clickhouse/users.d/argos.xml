<!--
  Argos ClickHouse users and profiles (docs/13-storage-design.md section 7.3, DSN-13-12, C-11,
  SEC-74, SEC-76). Install as /etc/clickhouse-server/users.d/argos.xml (Compose: mounted read-only).

  Accounts (least privilege):
    argos_writer    INSERT on the five raw tables only (argos.xlog, argos.profile_step,
                    argos.metric, argos.sql_stat_raw, argos.ext_stat_raw; docs/adr/0007 C-60,
                    SEC-76). Batch writer (13 section 7.4). No DDL, no SELECT, no INSERT into a
                    rollup table: the rollups are written only by the SQL SECURITY DEFINER views.
                    The profile pins what the batch writer relies on (constraints): async_insert,
                    insert_deduplicate, deduplicate_blocks_in_dependent_materialized_views,
                    log_queries, readonly and allow_ddl cannot be changed (passing the profile value
                    again is allowed), max_insert_threads stays 1 and max_memory_usage may only be
                    lowered.
    argos_reader    SELECT on argos.* and the system tables of the storage health panel.
                    readonly = 1: no INSERT, no DDL, no setting changes except the query limits
                    below, which a query may only lower (changeable_in_readonly constraints).
    argos_migrator  CREATE DATABASE, CREATE TABLE, CREATE VIEW, DROP DATABASE, DROP TABLE, DROP VIEW,
                    ALTER, INSERT, SELECT, BACKUP on argos.*, SELECT on system.mutations (the
                    deletion job polls the completion of its own mutations, C-60), and READ, WRITE
                    ON DISK (backup.sh and restore.sh). Migration runner, rollup rebuild, privacy
                    deletion mutations, emergency DROP PARTITION (13 section 7.3), ClickHouse backup
                    and restore.
                    Materialized views are created by this account and run with its rights
                    (SQL SECURITY DEFINER). No CREATE/DROP DICTIONARY, FUNCTION or NAMED COLLECTION:
                    Argos uses no ClickHouse dictionary (DSN-13-09), and a dictionary source would
                    let the server open connections to arbitrary hosts.
                    Backup and restore (docs/17 section 10, WO-43): READ and WRITE ON DISK as well.
                    ClickHouse 26.8 checks BACKUP/RESTORE ... Disk(...) against the unfiltered
                    source privilege (a grant filtered to the disk name is refused), so the disks
                    a backup may use are limited by the server setting backups.allowed_disk instead
                    (deploy/compose/config/clickhouse/backups.xml: the disk "backups" only). No READ
                    or WRITE ON FILE, URL or S3: file(), url() and s3() stay refused.
    default         removed (SEC-74).

  No password is written in this file. Substitution variables (ClickHouse from_env); ClickHouse
  refuses to start when one is unset or not a 64-hex-character SHA-256 (the SHA-256 of an empty
  password is accepted: weak or empty passwords must be rejected before hashing, docs/17 step 6):
    ARGOS_CH_WRITER_PASSWORD_SHA256, ARGOS_CH_READER_PASSWORD_SHA256,
    ARGOS_CH_MIGRATOR_PASSWORD_SHA256   SHA-256 (hex) of the CSPRNG passwords that the installer
                                        writes to the secrets directory (docs/17 section 3.7)
    ARGOS_CH_WRITER_MAX_MEMORY_USAGE    bytes per insert query. 16 GiB host: 2147483648 (2 GiB),
                                        otherwise about 0.27 x ARGOS_CH_MAX_SERVER_MEMORY_USAGE
    ARGOS_CH_READER_MAX_MEMORY_USAGE    bytes per read query. 16 GiB host: 3221225472 (3 GiB),
                                        otherwise 0.4 x ARGOS_CH_MAX_SERVER_MEMORY_USAGE

  Database name and table prefix: the grants name the default database "argos" and the default
  empty table prefix (argos.storage.clickhouse.database / table-prefix). An installation that changes
  them (DSN-13-11) writes the same grants with its own names: argos.* -> <db>.*, and for the writer
  <db>.<prefix>xlog, <db>.<prefix>profile_step, <db>.<prefix>metric, <db>.<prefix>sql_stat_raw and
  <db>.<prefix>ext_stat_raw (the installer renders them, WO-40).
-->
<clickhouse>
  <profiles>
    <argos_writer_profile>
      <readonly>0</readonly>
      <allow_ddl>0</allow_ddl>
      <async_insert>0</async_insert>
      <max_insert_threads>1</max_insert_threads>
      <max_memory_usage from_env="ARGOS_CH_WRITER_MAX_MEMORY_USAGE"/>
      <!-- Deduplication (13 section 5, D-13): the writer still passes the token and this setting on
           every INSERT; the profile makes them the default. -->
      <insert_deduplicate>1</insert_deduplicate>
      <deduplicate_blocks_in_dependent_materialized_views>1</deduplicate_blocks_in_dependent_materialized_views>
      <!-- The writer may not switch off what the batch writer contract relies on (dedup, sync
           inserts, query_log trace) nor lift its memory limit (SEC-76). A query may pass the
           profile value again (async_insert = 0, dedup = 1): an unchanged value is not checked. -->
      <constraints>
        <async_insert>
          <const/>
        </async_insert>
        <insert_deduplicate>
          <const/>
        </insert_deduplicate>
        <deduplicate_blocks_in_dependent_materialized_views>
          <const/>
        </deduplicate_blocks_in_dependent_materialized_views>
        <log_queries>
          <const/>
        </log_queries>
        <readonly>
          <const/>
        </readonly>
        <allow_ddl>
          <const/>
        </allow_ddl>
        <max_insert_threads>
          <min>1</min>
          <max>1</max>
        </max_insert_threads>
        <max_memory_usage>
          <min>1</min>
          <max from_env="ARGOS_CH_WRITER_MAX_MEMORY_USAGE"/>
        </max_memory_usage>
      </constraints>
    </argos_writer_profile>

    <argos_reader_profile>
      <readonly>1</readonly>
      <allow_ddl>0</allow_ddl>
      <max_memory_usage from_env="ARGOS_CH_READER_MAX_MEMORY_USAGE"/>
      <max_execution_time>10</max_execution_time>
      <max_threads>4</max_threads>
      <max_rows_to_read>2000000000</max_rows_to_read>
      <max_bytes_to_read>21474836480</max_bytes_to_read>
      <max_result_rows>200000</max_result_rows>
      <result_overflow_mode>break</result_overflow_mode>
      <max_concurrent_queries_for_user>20</max_concurrent_queries_for_user>
      <joined_subquery_requires_alias>0</joined_subquery_requires_alias>
      <!-- readonly = 1 rejects every setting change; the API passes per-query limits
           (13 section 6.3), so these limits may be changed within [min, max], never raised above
           the profile value and never set to 0 (= unlimited). -->
      <constraints>
        <max_execution_time>
          <min>1</min>
          <max>10</max>
          <changeable_in_readonly/>
        </max_execution_time>
        <max_memory_usage>
          <min>1</min>
          <max from_env="ARGOS_CH_READER_MAX_MEMORY_USAGE"/>
          <changeable_in_readonly/>
        </max_memory_usage>
        <max_threads>
          <min>1</min>
          <max>4</max>
          <changeable_in_readonly/>
        </max_threads>
        <max_rows_to_read>
          <min>1</min>
          <max>2000000000</max>
          <changeable_in_readonly/>
        </max_rows_to_read>
        <max_bytes_to_read>
          <min>1</min>
          <max>21474836480</max>
          <changeable_in_readonly/>
        </max_bytes_to_read>
        <max_result_rows>
          <min>1</min>
          <max>200000</max>
          <changeable_in_readonly/>
        </max_result_rows>
      </constraints>
    </argos_reader_profile>

    <argos_migrator_profile>
      <max_execution_time>3600</max_execution_time>
      <mutations_sync>0</mutations_sync>
    </argos_migrator_profile>
  </profiles>

  <users>
    <default remove="remove"/>

    <argos_writer>
      <password_sha256_hex from_env="ARGOS_CH_WRITER_PASSWORD_SHA256"/>
      <profile>argos_writer_profile</profile>
      <!-- Compose internal network; the tar install binds ClickHouse to 127.0.0.1 (listen_host). -->
      <networks>
        <ip>::/0</ip>
      </networks>
      <!-- INSERT on the raw tables only (C-60): ClickHouse grants one table per statement. -->
      <grants>
        <query>GRANT INSERT ON argos.xlog</query>
        <query>GRANT INSERT ON argos.profile_step</query>
        <query>GRANT INSERT ON argos.metric</query>
        <query>GRANT INSERT ON argos.sql_stat_raw</query>
        <query>GRANT INSERT ON argos.ext_stat_raw</query>
      </grants>
    </argos_writer>

    <argos_reader>
      <password_sha256_hex from_env="ARGOS_CH_READER_PASSWORD_SHA256"/>
      <profile>argos_reader_profile</profile>
      <networks>
        <ip>::/0</ip>
      </networks>
      <grants>
        <query>GRANT SELECT ON argos.*</query>
        <query>GRANT SELECT ON system.parts</query>
        <query>GRANT SELECT ON system.merges</query>
        <query>GRANT SELECT ON system.mutations</query>
        <query>GRANT SELECT ON system.events</query>
        <query>GRANT SELECT ON system.metrics</query>
        <query>GRANT SELECT ON system.asynchronous_metrics</query>
        <query>GRANT SELECT ON system.query_log</query>
        <query>GRANT SELECT ON system.disks</query>
      </grants>
    </argos_reader>

    <argos_migrator>
      <password_sha256_hex from_env="ARGOS_CH_MIGRATOR_PASSWORD_SHA256"/>
      <profile>argos_migrator_profile</profile>
      <networks>
        <ip>::/0</ip>
      </networks>
      <grants>
        <query>GRANT CREATE DATABASE, CREATE TABLE, CREATE VIEW, DROP DATABASE, DROP TABLE, DROP VIEW, ALTER, INSERT, SELECT, BACKUP ON argos.*</query>
        <query>GRANT SELECT ON system.mutations</query>
        <!-- BACKUP ... TO Disk('backups', ...), RESTORE ... FROM Disk('backups', ...) and the
             base_backup of an incremental backup (WO-43). -->
        <query>GRANT READ, WRITE ON DISK</query>
      </grants>
    </argos_migrator>
  </users>
</clickhouse>
