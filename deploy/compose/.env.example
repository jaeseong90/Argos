# SPDX-License-Identifier: Apache-2.0
#
# Every variable that compose*.yaml, argos-compose.sh and smoke.sh read, with an empty value and a
# one-line description. Do not copy this file to .env by hand: ./argos-env-init.sh writes .env
# (mode 0600) with computed values. No variable here holds a secret: secrets are files in
# secrets/ (docs/17 section 3.7). A variable set in the shell environment wins over .env.

# Image and version
# Version of the installation (the tag of the server image).
ARGOS_VERSION=
# Server image; default: the local build argos-server:<version> (./gradlew :server:jibDockerBuild).
ARGOS_SERVER_IMAGE=

# Addresses
# Address of the UI in the browser (scheme, host, port): deep links and the Origin check.
ARGOS_WEB_PUBLIC_URL=
# Host IPv4 address on which port 8080 (UI/API) is published; 127.0.0.1 behind a proxy (default 0.0.0.0).
ARGOS_HTTP_BIND=
# Host IPv4 address on which port 9100 (agent gRPC, TLS) is published (default 0.0.0.0).
ARGOS_GRPC_BIND=
# true: publish the management port on 127.0.0.1:8081 of the host (compose.mgmt.yaml; default false).
ARGOS_MGMT_EXPOSE=
# Client ranges allowed on /actuator/prometheus and /actuator/info, comma-separated (default: loopback and the Docker bridge pools).
ARGOS_METRICS_ALLOW_CIDRS=
# true: add the nginx reverse proxy of compose.proxy.yaml on 443 (default false).
ARGOS_PROXY=
# Host IPv4 address on which the proxy publishes 443 (default 0.0.0.0).
ARGOS_PROXY_BIND=
# Subnet of the front network with the proxy; choose one your LAN does not use (default 172.16.240.0/24).
ARGOS_PROXY_SUBNET=
# Fixed proxy address inside ARGOS_PROXY_SUBNET, the only one the server takes X-Forwarded-* from (default 172.16.240.254).
ARGOS_PROXY_IP=
# Leave empty: argos-compose.sh derives it from ARGOS_PROXY_IP (the server's trusted proxy as a regular expression).
ARGOS_PROXY_IP_REGEX=

# Setup
# true: unattended setup from secrets/admin_password (compose.unattended.yaml; default false: setup token wizard).
ARGOS_UNATTENDED=
# Unattended setup only: IP address collection mode, masked, full or off (required then).
ARGOS_IP_MODE=
# Unattended setup only: name of the first administrator (default admin).
ARGOS_ADMIN_USERNAME=

# Server
# Health check grace period of the server after a start, for example 60s or 180s (default 60s).
ARGOS_START_PERIOD=
# Server log level: ERROR, WARN, INFO, DEBUG (default INFO).
ARGOS_LOG_LEVEL=
# Time zone of alert messages; storage is always UTC (default UTC).
ARGOS_TZ_DISPLAY=
# false only for an evaluation over plain HTTP from another host: session cookies without Secure (default true).
ARGOS_SECURITY_COOKIE_SECURE=

# Memory (argos-env-init.sh computes these from the host memory, docs/17 section 7.3)
# Memory limit of the server container, for example 5120m (heap + 1 GiB).
ARGOS_SERVER_MEM=
# JVM heap of the server, for example "-Xms4096m -Xmx4096m"; printed by the JVM at start, never a secret.
ARGOS_SERVER_JAVA_OPTS=
# Memory limit of the ClickHouse container, for example 8152m (server + PostgreSQL + ClickHouse containers <= 0.9 x host memory).
ARGOS_CH_MEM=
# ClickHouse max_server_memory_usage in bytes (0.9 x ARGOS_CH_MEM).
ARGOS_CH_MAX_SERVER_MEMORY_USAGE=
# ClickHouse memory limit of one insert of the writer account, bytes (4/15 of the server limit).
ARGOS_CH_WRITER_MAX_MEMORY_USAGE=
# ClickHouse memory limit of one query of the reader account, bytes (2/5 of the server limit).
ARGOS_CH_READER_MAX_MEMORY_USAGE=
# Memory limit of the PostgreSQL container (3 x shared_buffers, at least 1024m).
ARGOS_PG_MEM=
# PostgreSQL shared_buffers, for example 491MB (host memory x 0.03).
ARGOS_PG_SHARED_BUFFERS=
# PostgreSQL effective_cache_size, for example 982MB (2 x shared_buffers).
ARGOS_PG_EFFECTIVE_CACHE_SIZE=

# Retention in days (docs/13 defaults 30, 7, 14, 14, 90, 365)
# Transactions (XLog).
ARGOS_RETENTION_XLOG_DAYS=
# Transaction profiles (steps).
ARGOS_RETENTION_PROFILE_DAYS=
# Raw SQL and external call statistics; must equal ARGOS_RETENTION_METRIC_DAYS in this version.
ARGOS_RETENTION_RAW_STAT_DAYS=
# Raw metrics; must equal ARGOS_RETENTION_RAW_STAT_DAYS in this version.
ARGOS_RETENTION_METRIC_DAYS=
# One-minute rollups.
ARGOS_RETENTION_ROLLUP_1M_DAYS=
# One-hour rollups.
ARGOS_RETENTION_ROLLUP_1H_DAYS=

# Docker Compose
# Compose project name (default argos, the name in compose.yaml); prefixes the containers, networks and volumes.
COMPOSE_PROJECT_NAME=
