#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# Test double of the docker CLI for the container-side script tests (never shipped). It answers the
# calls of argos-env-init.sh, argos-compose.sh and smoke.sh from environment variables:
#   FAKE_DOCKER_LOG             file: every call is appended to it as one line (its arguments)
#   FAKE_DOCKER_DOWN=1          'docker version' and 'docker info' fail (daemon not reachable)
#   FAKE_DOCKER_VERSION         server version (default 29.2.1)
#   FAKE_DOCKER_OS              docker info OperatingSystem (default "Docker Desktop")
#   FAKE_DOCKER_MEM             docker info MemTotal in bytes (default 16 GiB)
#   FAKE_DOCKER_ROOT            docker info DockerRootDir (default /nonexistent)
#   FAKE_DOCKER_SECURITY        docker info SecurityOptions as JSON
#   FAKE_NO_COMPOSE=1           'docker compose' is not installed
#   FAKE_COMPOSE_VERSION        compose version (default 2.29.7)
#   FAKE_PS_JSON                file printed by 'docker compose ps --format json'
#   FAKE_PS_EMPTY=1             'docker compose ps -q' prints no container
#   FAKE_UP_EXIT                exit code of 'docker compose up' (default 0)
#   FAKE_IMAGE_MISSING=1        'docker image inspect' fails (not in the local image store)
#   FAKE_VOLUMES                'docker volume ls -q' output (names separated by spaces) for the
#                               Compose project FAKE_VOLUME_PROJECT (default argos)
#   FAKE_HEALTH                 health of every container (default healthy)
#   FAKE_PROJECT                com.docker.compose.project label of the containers (default argos)
#   FAKE_IMAGE_CLICKHOUSE, FAKE_IMAGE_POSTGRES, FAKE_IMAGE_SERVER
#                               .Config.Image of the containers
#   FAKE_BACK_INTERNAL          .Internal of the network <project>_back (default true)
#   FAKE_NETS_CLICKHOUSE, FAKE_NETS_POSTGRES, FAKE_NETS_SERVER
#                               networks of the containers (default: back; the server back and front)
#   FAKE_SERVER_UID             uid and gid of the server process (default 10001)
#   FAKE_DATA_WRITABLE=0        the server cannot write /data
#   FAKE_DATA_STAT              'stat -c "%u:%g %a" /data' in the server (default "10001:10001 700")
#   FAKE_SETUP_TOKEN_FILE=1     /data/setup-token exists in the server
#   FAKE_ADMIN_ARGS             file: the arguments of 'compose exec ... server java ... admin token
#                               create' (argos-admin in the server container) are saved
#   FAKE_ADMIN_EXIT             its exit code (default 0: prints the JSON result with a token
#                               generated at run time; 4: the limit; others: a failure)
#   FAKE_SIGNAL                 INT or TERM: 'compose ps --format json' and argos-admin send it to
#                               the outermost process whose arguments contain FAKE_SIGNAL_TARGET
#                               (for example ./smoke.sh), then answer as usual
# WO-43 (upgrade, diag):
#   FAKE_IMAGES                 file of local images, one "reference id version" per line: then
#                               'docker image inspect' knows only these (by reference or id) and
#                               answers --format .Id, the version label and RepoDigests from it
#                               (version "-": the image has no version label)
#   FAKE_IMAGE_ID_SERVER        .Image (image id) of the server container (default sha256:old)
#   FAKE_PULL_EXIT              exit code of 'docker pull' (default 1, nothing pulled)
#   FAKE_AGENT_VERSIONS         file printed by psql in the postgres container (agent_version|count)
#   FAKE_PSQL_EXIT              exit code of that psql (default 0)
#   FAKE_CONSISTENCY_EXIT       exit code of argos-admin consistency check (default 0)
#   FAKE_BUNDLE_EXIT            exit code of argos-admin bundle (default 0: prints the JSON result)
#   FAKE_BUNDLE_FILE            the "file" of that result (default /data/tmp/argos-diag-fake-<ts>.tar.gz)
#   FAKE_LOG_DIR                directory with <service>.log printed by 'compose logs ... <service>'
#   FAKE_DF_EXIT                exit code of 'df -P' in the clickhouse container (default 0)
#   'compose run --rm --no-deps -T -e .. --entrypoint E SERVICE ARGS' answers as 'compose exec
#   SERVICE E ARGS'.
# WO-42 (ops-report.sh; its container shells end with the marker argument argos-ops-report):
#   FAKE_OPS_STATE              .State.Status of every container (default running)
#   FAKE_OPS_STARTED_AT         .State.StartedAt of every container
#                               (default 2026-11-12T08:00:00.123456789Z)
#   FAKE_OPS_RESTARTS           .RestartCount of every container (default 0)
#   FAKE_OPS_PSQL               file printed by the psql of ops-report.sh in the postgres container
#   FAKE_OPS_PSQL_EXIT          exit code of that psql (default 0)
#   FAKE_OPS_SQL_LOG            file: the SQL that psql received on standard input is appended
#   FAKE_OPS_PROMETHEUS         file printed by the /actuator/prometheus scrape in the server container
#   FAKE_OPS_PROM_EXIT          exit code of that scrape (default 0; non-zero: curl's 401 message)
#   FAKE_OPS_DF_PERCENT         use of the ClickHouse data volume in 'df -P /var/lib/clickhouse'
#                               (default 40; FAKE_DF_EXIT applies too)

if [ -n "${FAKE_DOCKER_LOG:-}" ]; then
  printf '%s\n' "$*" >>"$FAKE_DOCKER_LOG"
fi

send_signal() {
  [ -n "${FAKE_SIGNAL:-}" ] || return 0
  target=${FAKE_SIGNAL_TARGET:?FAKE_SIGNAL_TARGET is not set}
  pid=$$
  found=
  while [ "$pid" -gt 1 ]; do
    pid=$(sed -n 's/^PPid:[[:space:]]*//p' "/proc/$pid/status" 2>/dev/null)
    [ -n "$pid" ] || break
    if tr '\0' '\n' <"/proc/$pid/cmdline" 2>/dev/null | grep -qxF -- "$target"; then
      found=$pid
    fi
  done
  [ -n "$found" ] || { echo "fake docker: no process runs $target" >&2; exit 1; }
  kill -s "$FAKE_SIGNAL" "$found"
}

service_of() { # service_of <container id>: the fake ids are fake-<service>
  printf '%s' "${1#fake-}"
}

uid=${FAKE_SERVER_UID:-10001}
project=${FAKE_PROJECT:-argos}

case ${1:-} in
  version)
    [ -z "${FAKE_DOCKER_DOWN:-}" ] || exit 1
    printf '%s\n' "${FAKE_DOCKER_VERSION:-29.2.1}"
    ;;
  info)
    [ -z "${FAKE_DOCKER_DOWN:-}" ] || exit 1
    case "$*" in
      *MemTotal*)
        printf '%s|%s|%s|%s\n' "${FAKE_DOCKER_OS:-Docker Desktop}" "${FAKE_DOCKER_MEM:-17179869184}" \
          "${FAKE_DOCKER_ROOT:-/nonexistent}" "${FAKE_DOCKER_SECURITY:-[\"name=seccomp,profile=builtin\"]}"
        ;;
      *OperatingSystem*) printf '%s\n' "${FAKE_DOCKER_OS:-Docker Desktop}" ;;
      *) echo "fake docker info" ;;
    esac
    ;;
  image)
    [ "${2:-}" = inspect ] || { echo "fake docker: unsupported: $*" >&2; exit 1; }
    ref=
    for a in "$@"; do ref=$a; done # the last argument
    [ -z "${FAKE_IMAGE_MISSING:-}" ] || { echo "Error: No such image: $ref" >&2; exit 1; }
    if [ -n "${FAKE_IMAGES:-}" ]; then
      row=$(awk -v r="$ref" '$1 == r || $2 == r { print; exit }' "$FAKE_IMAGES")
      [ -n "$row" ] || { echo "Error: No such image: $ref" >&2; exit 1; }
      img_ref=${row%% *}
      rest=${row#* }
      img_id=${rest%% *}
      img_version=${rest#* }
      [ "$img_version" != - ] || img_version= # "-": an image without the version label
      case "$*" in
        *image.version*) printf '%s\n' "$img_version" ;;
        *RepoDigests*) printf '  RepoDigests: ["%s@sha256:%s"]\n  Labels: {"org.opencontainers.image.version":"%s"}\n' "${img_ref%%:*}" "${img_id#sha256:}" "$img_version" ;;
        *.Id*) printf '%s\n' "$img_id" ;;
        *) printf '[{"Id":"%s"}]\n' "$img_id" ;;
      esac
      exit 0
    fi
    case "$*" in
      *RepoDigests*) printf '  RepoDigests: []\n  Labels: {}\n' ;;
      *) echo '[{"Id":"sha256:fake"}]' ;;
    esac
    ;;
  pull) exit "${FAKE_PULL_EXIT:-1}" ;;
  volume)
    [ "${2:-}" = ls ] || { echo "fake docker: unsupported: $*" >&2; exit 1; }
    case "$*" in
      *"label=com.docker.compose.project=${FAKE_VOLUME_PROJECT:-argos}") ;;
      *) exit 0 ;;
    esac
    for v in ${FAKE_VOLUMES:-}; do
      printf '%s\n' "$v"
    done
    ;;
  network)
    [ "${2:-}" = inspect ] || { echo "fake docker: unsupported: $*" >&2; exit 1; }
    eval "name=\${$#}"
    [ "$name" = "${project}_back" ] || { echo "Error: network $name not found" >&2; exit 1; }
    printf '%s\n' "${FAKE_BACK_INTERNAL:-true}"
    ;;
  inspect)
    [ "${2:-}" = --format ] || { echo "fake docker: unsupported: $*" >&2; exit 1; }
    format=$3
    svc=$(service_of "$4")
    case $format in
      *State.Health*) printf '%s\n' "${FAKE_HEALTH:-healthy}" ;;
      '{{.Name}} {{.Config.Image}} {{.Image}}')
        case $svc in
          server) printf '/argos-server-1 %s %s\n' "${FAKE_IMAGE_SERVER:-argos-server:0.0.0-SNAPSHOT}" "${FAKE_IMAGE_ID_SERVER:-sha256:old}" ;;
          clickhouse | postgres) printf '/argos-%s-1 %s-image sha256:%s\n' "$svc" "$svc" "$svc" ;;
          *) exit 1 ;;
        esac
        ;;
      '{{.Image}}')
        [ "$svc" = server ] || exit 1
        printf '%s\n' "${FAKE_IMAGE_ID_SERVER:-sha256:old}"
        ;;
      *Config.Image*)
        case $svc in
          clickhouse) printf '%s\n' "${FAKE_IMAGE_CLICKHOUSE:-}" ;;
          postgres) printf '%s\n' "${FAKE_IMAGE_POSTGRES:-}" ;;
          server) printf '%s\n' "${FAKE_IMAGE_SERVER:-}" ;;
          *) exit 1 ;;
        esac
        ;;
      *com.docker.compose.project*) printf '%s\n' "$project" ;;
      *NetworkSettings.Networks*)
        case $svc in
          clickhouse) printf '%s\n' "${FAKE_NETS_CLICKHOUSE:-${project}_back }" ;;
          postgres) printf '%s\n' "${FAKE_NETS_POSTGRES:-${project}_back }" ;;
          server) printf '%s\n' "${FAKE_NETS_SERVER:-${project}_back ${project}_front }" ;;
          *) exit 1 ;;
        esac
        ;;
      *RestartCount*)
        printf '%s|%s|%s\n' "${FAKE_OPS_STATE:-running}" "${FAKE_OPS_STARTED_AT:-2026-11-12T08:00:00.123456789Z}" "${FAKE_OPS_RESTARTS:-0}"
        ;;
      *) echo "fake docker inspect: unsupported format: $format" >&2; exit 1 ;;
    esac
    ;;
  compose)
    shift
    if [ -n "${FAKE_NO_COMPOSE:-}" ]; then
      echo "docker: 'compose' is not a docker command." >&2
      exit 1
    fi
    while [ $# -gt 0 ]; do
      case $1 in
        -f | -p | --profile) shift 2 ;;
        *) break ;;
      esac
    done
    case ${1:-} in
      version) printf '%s\n' "${FAKE_COMPOSE_VERSION:-2.29.7}" ;;
      ps)
        case "$*" in
          *json*)
            send_signal
            cat "${FAKE_PS_JSON:?FAKE_PS_JSON is not set}"
            ;;
          *-q*)
            [ -z "${FAKE_PS_EMPTY:-}" ] || exit 0
            eval "last=\${$#}"
            # shellcheck disable=SC2154 # assigned by the eval above (the last argument; POSIX sh has no ${@: -1})
            case $last in
              -q)
                case "$*" in
                  *--all* | *" -a "*) printf 'fake-server\nfake-clickhouse\nfake-postgres\n' ;;
                  *) echo fake-all ;;
                esac
                ;;
              *) printf 'fake-%s\n' "$last" ;;
            esac
            ;;
          *) echo "NAME SERVICE STATUS" ;;
        esac
        ;;
      up) exit "${FAKE_UP_EXIT:-0}" ;;
      down) ;;
      logs)
        eval "last=\${$#}"
        if [ -n "${FAKE_LOG_DIR:-}" ] && [ -f "$FAKE_LOG_DIR/$last.log" ]; then
          cat "$FAKE_LOG_DIR/$last.log"
        fi
        ;;
      exec | run)
        shift
        entry=
        while [ $# -gt 0 ]; do
          case $1 in
            -T | --rm | --no-deps) shift ;;
            -e) shift 2 ;;
            --entrypoint) entry=$2; shift 2 ;;
            *) break ;;
          esac
        done
        svc=${1:-}
        shift
        if [ -n "$entry" ]; then
          set -- "$entry" "$@"
        fi
        case "$svc $*" in
          "server java "*" admin consistency check "*)
            echo "Consistency check: no mismatch (fake)"
            exit "${FAKE_CONSISTENCY_EXIT:-0}"
            ;;
          "server java "*" admin bundle "*)
            code=${FAKE_BUNDLE_EXIT:-0}
            if [ "$code" -ne 0 ]; then
              echo "argos-admin bundle: The bundle cannot be written: IOException" >&2
              printf '{"command":"bundle","error":"The bundle cannot be written: IOException","code":"write_failed"}\n'
              exit "$code"
            fi
            printf '{"command":"bundle","file":"%s","bytes":321,"sections":[{"name":"log","ok":true,"detail":"server.log"},{"name":"storage","ok":false,"detail":"ClickHouse unreachable"}],"entries":["manifest.json"]}\n' \
              "${FAKE_BUNDLE_FILE:-/data/tmp/argos-diag-fake-20261126T000000Z.tar.gz}"
            ;;
          "server cat /data/tmp/"*)
            d=$(mktemp -d)
            printf '{"kind":"argos-diag","masked":true}\n' >"$d/manifest.json"
            tar -czf - -C "$d" manifest.json
            rm -rf "$d"
            ;;
          "server rm -f /data/tmp/"*) ;;
          "clickhouse df -P /var/lib/clickhouse")
            [ "${FAKE_DF_EXIT:-0}" -eq 0 ] || { echo "df: failed" >&2; exit "$FAKE_DF_EXIT"; }
            p=${FAKE_OPS_DF_PERCENT:-40}
            printf 'Filesystem 1024-blocks Used Available Capacity Mounted on\n/dev/sdb1 100000 %s %s %s%% /var/lib/clickhouse\n' \
              "$((p * 1000))" "$((100000 - p * 1000))" "$p"
            ;;
          "postgres sh -c "*psql*" argos-ops-report")
            if [ -n "${FAKE_OPS_SQL_LOG:-}" ]; then
              cat >>"$FAKE_OPS_SQL_LOG"
            else
              cat >/dev/null
            fi
            code=${FAKE_OPS_PSQL_EXIT:-0}
            if [ "$code" -ne 0 ]; then
              echo 'psql: error: connection to server at "127.0.0.1", port 5432 failed: FATAL:  password authentication failed for user "argos_backup"' >&2
              exit "$code"
            fi
            if [ -n "${FAKE_OPS_PSQL:-}" ]; then
              cat "$FAKE_OPS_PSQL"
            fi
            ;;
          "server sh -c "*actuator/prometheus*" argos-ops-report")
            code=${FAKE_OPS_PROM_EXIT:-0}
            if [ "$code" -ne 0 ]; then
              echo "curl: (22) The requested URL returned error: 401" >&2
              exit "$code"
            fi
            cat "${FAKE_OPS_PROMETHEUS:?FAKE_OPS_PROMETHEUS is not set}"
            ;;
          "clickhouse df -P")
            [ "${FAKE_DF_EXIT:-0}" -eq 0 ] || { echo "df: failed" >&2; exit "$FAKE_DF_EXIT"; }
            printf 'Filesystem 1024-blocks Used Available Capacity Mounted on\noverlay 100000 40000 60000 40%% /\n'
            ;;
          "postgres sh -c "*psql*)
            cat >/dev/null
            [ "${FAKE_PSQL_EXIT:-0}" -eq 0 ] || { echo "psql: error: connection refused" >&2; exit "$FAKE_PSQL_EXIT"; }
            if [ -n "${FAKE_AGENT_VERSIONS:-}" ]; then
              cat "$FAKE_AGENT_VERSIONS"
            fi
            ;;
          "server java "*" admin token create "*)
            if [ -n "${FAKE_ADMIN_ARGS:-}" ]; then
              printf '%s\n' "$*" >"$FAKE_ADMIN_ARGS"
            fi
            send_signal
            app=
            env=
            while [ $# -gt 0 ]; do
              case $1 in
                --app) app=$2; shift 2 ;;
                --env) env=$2; shift 2 ;;
                *) shift ;;
              esac
            done
            code=${FAKE_ADMIN_EXIT:-0}
            case $code in
              0)
                # A token of the 16 section 2.1 shape, generated now (never a literal in the tree).
                t=$(head -c 32 /dev/urandom | base64 | tr -d '\n=' | tr '+/' '-_' | cut -c1-43)
                printf '{"command":"token create","app":"%s","env":"%s","app_id":42,"app_created":true,"token_id":"0b6f5c4e-1d2a-4b3c-8d4e-5f6a7b8c9d0e","prefix":"argos_%s","expires_at":"2027-11-23T10:00:00Z","token":"argos_%s"}\n' "$app" "$env" "$(printf '%s' "$t" | cut -c1-8)" "$t" # gitleaks:allow (fake token generated at run time)
                ;;
              4)
                echo '{"level":"INFO","message":"argos-admin"}' >&2
                echo "argos-admin token create: The application has its maximum of 5 active agent tokens" >&2
                printf '{"command":"token create","error":"The application has its maximum of 5 active agent tokens","code":"token_limit"}\n'
                ;;
              *)
                echo '{"level":"ERROR","message":"argos-admin"}' >&2
                echo "argos-admin token create: PostgreSQL: cannot connect as argos_app" >&2
                printf '{"command":"token create","error":"PostgreSQL: cannot connect as argos_app","code":"database"}\n'
                ;;
            esac
            exit "$code"
            ;;
          "server sh -c "*/proc/1/status*)
            printf 'Uid:\t%s\t%s\t%s\t%s\nGid:\t%s\t%s\t%s\t%s\n' "$uid" "$uid" "$uid" "$uid" "$uid" "$uid" "$uid" "$uid"
            ;;
          "server sh -c "*/data/.argos-smoke*)
            [ "${FAKE_DATA_WRITABLE:-1}" != 0 ] || { echo "sh: can't create /data/.argos-smoke: Permission denied" >&2; exit 1; }
            ;;
          "server stat -c %u:%g %a /data") printf '%s\n' "${FAKE_DATA_STAT:-10001:10001 700}" ;;
          "server stat -c %a %u:%g /data/setup-token")
            [ "${FAKE_SETUP_TOKEN_FILE:-0}" = 1 ] || exit 1
            echo "600 10001:10001"
            ;;
          "server test ! -e /data/setup-token") [ "${FAKE_SETUP_TOKEN_FILE:-0}" != 1 ] ;;
          "server test -f /data/setup-token") [ "${FAKE_SETUP_TOKEN_FILE:-0}" = 1 ] ;;
          "server wget "*) echo '{"status":"UP"}' ;;
          *)
            echo "fake docker compose exec: unsupported: $svc $*" >&2
            exit 1
            ;;
        esac
        ;;
      *)
        echo "fake docker compose: unsupported: $*" >&2
        exit 1
        ;;
    esac
    ;;
  *)
    echo "fake docker: unsupported: $*" >&2
    exit 1
    ;;
esac
