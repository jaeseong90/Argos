ARGOS_SERVER_JAVA_OPTS="-Xms1740m -Xmx1740m"
ARGOS_CH_MEM=2048m
ARGOS_CH_MAX_SERVER_MEMORY_USAGE=1932735283
ARGOS_CH_WRITER_MAX_MEMORY_USAGE=515396075
ARGOS_CH_READER_MAX_MEMORY_USAGE=773094113
ARGOS_PG_MEM=1024m
ARGOS_PG_SHARED_BUFFERS=256MB
ARGOS_PG_EFFECTIVE_CACHE_SIZE=512MB
