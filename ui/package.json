{
  "name": "@argos-apm/ui",
  "version": "0.0.0-SNAPSHOT",
  "private": true,
  "description": "Argos APM web UI",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-licenses.mjs --require-bundle --notices dist/licenses.txt && node scripts/check-no-external.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "check:external": "node scripts/check-no-external.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:licenses:dev": "node scripts/check-licenses.mjs --dev",
    "e2e": "vite build && playwright test",
    "perf": "vite build && playwright test --config playwright.perf.config.ts",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "i18next": "26.4.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.0.20",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
