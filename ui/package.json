{
  "name": "@argos-apm/ui",
  "version": "0.0.0-SNAPSHOT",
  "private": true,
  "description": "Argos APM web UI",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-licenses.mjs --require-bundle --notices dist/licenses.txt --about-json build/licenses/ui.json --sbom build/sbom/ui.cdx.json && node scripts/check-no-external.mjs && node scripts/bundle-size.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc -b",
    "gen:api": "node scripts/gen-api.mjs",
    "check:api": "node scripts/gen-api.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "check:external": "node scripts/check-no-external.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:licenses:dev": "node scripts/check-licenses.mjs --dev",
    "bundle:size": "node scripts/bundle-size.mjs",
    "e2e": "vite build --mode perf --outDir build/perf-dist && playwright test --project preview --project stack",
    "e2e:preview": "vite build --mode perf --outDir build/perf-dist && playwright test --project preview",
    "e2e:stack": "playwright test --project stack",
    "e2e:fresh": "playwright test --project fresh-install",
    "e2e:docker": "node e2e/stack/cli.ts docker",
    "e2e:stack:up": "node e2e/stack/cli.ts up",
    "e2e:stack:down": "node e2e/stack/cli.ts down",
    "perf": "vite build --mode perf --outDir build/perf-dist && playwright test --config playwright.perf.config.ts",
    "perf:initial-load": "playwright test --project initial-load",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.26",
    "antd": "6.7.0",
    "dayjs": "1.11.23",
    "i18next": "26.4.7",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.0.20",
    "react-router": "8.5.0",
    "uplot": "1.6.32",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
